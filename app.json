{
  "expo": {
    "name": "RotaFrete",
    "slug": "rotafrete",
    "version": "4.7.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "rotafrete",
    "userInterfaceStyle": "dark",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F172A"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.rotafrete.app",
      "config": {
        "googleMapsApiKey": "AIzaSyBSIb8dplnpJRYACe-W9v_3HtpSCYArVP4"
      }
    },
    "android": {
      "versionCode": 47001,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F172A"
      },
      "package": "com.rotafrete.app",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyBSIb8dplnpJRYACe-W9v_3HtpSCYArVP4"
        }
      },
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "WAKE_LOCK",
        "POST_NOTIFICATIONS",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "REQUEST_INSTALL_PACKAGES"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "@react-native-firebase/app",
      "@react-native-firebase/messaging",
      [
        "expo-notifications",
        {
          "color": "#3B82F6"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "O RotaFrete precisa acessar sua localização para calcular a rota mesmo com o app em segundo plano.",
          "locationAlwaysPermission": "Permitir \"o tempo todo\" para tracking preciso da rota.",
          "locationWhenInUsePermission": "Precisamos da sua localização para calcular a rota.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "expo-task-manager",
      "@react-native-community/datetimepicker",
      "./plugins/withFirebaseMessagingFix"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "b040641f-622c-4f0f-bf6c-6ae39d7e8c73"
      }
    },
    "owner": "allanfsouza"
  }
}