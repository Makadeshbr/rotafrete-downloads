{
    "cli": {
        "version": ">= 12.0.0"
    },
    "build": {
        "development": {
            "developmentClient": true,
            "distribution": "internal",
            "android": {
                "buildType": "apk",
                "gradleCommand": ":app:assembleDebug"
            },
            "ios": {
                "simulator": true
            }
        },
        "preview": {
            "distribution": "internal",
            "android": {
                "buildType": "apk"
            }
        },
        "release": {
            "distribution": "internal",
            "developmentClient": false,
            "android": {
                "buildType": "apk",
                "gradleCommand": ":app:assembleRelease"
            }
        },
        "production": {
            "android": {
                "buildType": "app-bundle"
            }
        },
        "local": {
            "distribution": "internal",
            "android": {
                "buildType": "apk",
                "gradleCommand": ":app:assembleRelease"
            }
        }
    },
    "submit": {
        "production": {}
    }
}